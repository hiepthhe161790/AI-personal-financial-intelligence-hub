# =========================================================================
# AI Personal Financial Intelligence Hub - Môi trường cấu hình (.env.example)
# =========================================================================

# 1. Cơ sở dữ liệu MongoDB (Dùng MongoDB Atlas cho Production)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_financial_hub

# 2. Cấu hình môi trường & Bí mật Next.js Core
NODE_ENV=development
APP_SECRET=super_secret_personal_financial_hub_key_change_me_in_prod

# 3. NextAuth Configuration (Xác thực đăng nhập người dùng)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=production_super_secret_jwt_key_2026_change_me_in_prod

# 4. Khóa mã hóa dữ liệu (Dùng để mã hóa API Key của user khi lưu vào DB)
# LƯU Ý: Khóa này PHẢI đúng 32 ký tự để thuật toán AES-256-CBC hoạt động chính xác.
ENCRYPTION_KEY=default_secret_key_32_bytes_length_ok!

# 5. AI API Keys mặc định của hệ thống (Gemini & Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 6. Đường dẫn tới API Python (FastAPI Sidecar)
PYTHON_SERVICE_URL=http://localhost:8000

# 7. Cấu hình gửi thông báo qua Telegram Bot (Gói PRO)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 8. Cấu hình Cổng thanh toán PayOS (Thanh toán SaaS nâng cấp gói PRO)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# 9. Đăng nhập bằng Google (Google OAuth) - Nhập từ Google Cloud Console
GOOGLE_CLIENT_ID=mock_google_id
GOOGLE_CLIENT_SECRET=mock_google_secret
